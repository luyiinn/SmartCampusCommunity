<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.dewmark.smartcampuscommunity.mapper.TagMapper">


    <select id="selectTagNamesByPostId" resultType="java.lang.String">
        select t.name
        from tag t
        where id in (
        select pt.tag_id
        from post_tag pt
        where pt.post_id = #{id}
            )
        order by t.use_count desc
    </select>
</mapper>